('mama-amina-biryani', '00000000-0000-0000-0000-000000000003', 'Mama Amina Biryani House', 'mama-amina-biryani', 'Zanzibar Biryani & Pilau', 'Authentic Zanzibar dum biryani slow-cooked with fresh local spices.', 'VERIFIED_SELLER', 4.9, 142, 6000, 25000, 'Old Bagamoyo Rd, Mikocheni B', 'Mikocheni', 'Dar es Salaam', 0.8, 30, TRUE, TRUE, 'VERIFIED', '109-887-234', 'BL-DAR-2025-0992', '+255754889120', 'M-Pesa', '09:00 AM', '09:00 PM', 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=800&q=80', 'Authentic Zanzibar Beef Biryani', 'TOP_CHEF', '🍚', ARRAY['Biryani', 'Pilau', 'Mikocheni', 'Halal']),
('kibo-mchemsho', NULL, 'Kibo Peak Mchemsho Spot', 'kibo-mchemsho', 'Swahili Soups & Healthy Boils', 'Nutritious slow-simmered beef and fish broth with sweet potatoes and green bananas.', 'BASIC_SELLER', 4.7, 89, 5000, 18000, 'Sinza Mori Near Deluxe', 'Sinza', 'Dar es Salaam', 2.3, 20, TRUE, TRUE, 'VERIFIED', '201-445-889', 'BL-DAR-2024-5512', '+255784999111', 'Airtel Money', '06:30 AM', '08:00 PM', 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800&q=80', 'Special Supu ya Mkia', 'LOCAL_LEGEND', '🥣', ARRAY['Supu', 'Mchemsho', 'Sinza', 'Healthy']),
('green-leaf', NULL, 'Green Leaf Fresh Kitchen', 'green-leaf', 'Healthy Salads & Vegan Bowls', 'Fresh organic salads and cold-pressed juices.', 'VERIFIED_SELLER', 4.8, 64, 8000, 22000, 'Masaki Chole Road', 'Masaki', 'Dar es Salaam', 3.5, 25, TRUE, TRUE, 'VERIFIED', '330-998-112', 'BL-DAR-2025-1104', '+255715222333', 'Mixx by Yas', '08:00 AM', '08:00 PM', 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=800&q=80', 'Avocado Protein Bowl', 'VERIFIED_ORGANIC', '🥗', ARRAY['Salad', 'Vegan', 'Masaki', 'Gluten-Free']),
('samaki-samaki-mwenge', '00000000-0000-0000-0000-000000000005', 'Samaki Samaki Seafood Bar', 'samaki-samaki-mwenge', 'Seafood & Swahili Grills', 'Crispy spiced red snapper, prawns, coconut coconut fish soup, and roasted cassava.', 'VERIFIED_SELLER', 4.85, 210, 8000, 35000, 'Mwenge ITV Junction', 'Mwenge', 'Dar es Salaam', 1.8, 35, TRUE, TRUE, 'VERIFIED', '405-112-990', 'BL-DAR-2025-8833', '+255713444555', 'M-Pesa', '11:00 AM', '11:00 PM', 'https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?w=800&q=80', 'Pweza wa Nazi & Samaki Choma', 'SEAFOOD_SPECIALIST', '🐟', ARRAY['Seafood', 'Fish', 'Mwenge', 'Dinner Spot']),
('kariakoo-ugali-choma', NULL, 'Kariakoo Tamu Tamu Kitchen', 'kariakoo-ugali-choma', 'Traditional Swahili Comfort Food', 'Steaming hot dona ugali served with mbuzi choma, mchicha wa nazi, and fresh pili pili.', 'BASIC_SELLER', 4.6, 75, 3500, 15000, 'Msimbazi Street, Kariakoo', 'Kariakoo', 'Dar es Salaam', 5.2, 15, TRUE, TRUE, 'VERIFIED', NULL, NULL, '+255762000111', 'M-Pesa', '06:00 AM', '10:00 PM', 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80', 'Ugali Afya na Mbuzi Choma', 'STREET_HERO', '🥩', ARRAY['Ugali', 'Nyama Choma', 'Kariakoo', 'Affordable'])
ON CONFLICT (id) DO UPDATE SET
