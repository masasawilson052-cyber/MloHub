{
  "name": "mlohub-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "demo:audit": "tsx --require ./lib/e2eBootstrap.js scripts/demo-readiness-audit.ts",
    "test": "tsx tests/runAllSuites.ts",
    "test:repairs": "tsx tests/finalRepairBehavior.test.ts",
    "preview": "node scripts/serve-demo.cjs",
    "demo:build": "node scripts/build-offline-demo.cjs",
    "demo:preview": "node scripts/serve-demo.cjs dist-offline",
    "test:offline": "tsx tests/offlineDemo.test.ts",
    "security:test": "tsx --require ./lib/e2eBootstrap.js scripts/security-smoke-test.ts",
    "e2e:pack4a": "tsx --require ./lib/e2eBootstrap.js scripts/test-pack4a-custom-meals-e2e.ts",
    "e2e:pack4b": "tsx scripts/test-pack4b-reservation-capacity-e2e.ts",
    "e2e:pack4c": "tsx scripts/test-pack4c-financial-authority-e2e.ts",
    "e2e:pack4d": "tsx scripts/test-pack4d-reviews-trust-e2e.ts",
    "e2e:pack4e": "tsx --require ./lib/e2eBootstrap.js scripts/test-pack4e-notifications-communication-e2e.ts",
    "e2e:pack4f": "tsx --require ./lib/e2eBootstrap.js scripts/test-pack4f-restaurant-operations-e2e.ts",
    "e2e:stage3": "tsx --require ./lib/e2eBootstrap.js scripts/test-stage3-onboarding-e2e.ts",
    "e2e:orders": "tsx --require ./lib/e2eBootstrap.js scripts/test-order-pipeline-authority.ts",
    "e2e:auth": "tsx --require ./lib/e2eBootstrap.js tests/realAuthSessions.test.ts",
    "e2e:all": "npm run e2e:stage3 && npm run e2e:orders && npm run e2e:auth && npm run e2e:pack4a && npm run e2e:pack4b && npm run e2e:pack4c && npm run e2e:pack4d && npm run e2e:pack4e && npm run e2e:pack4f",
    "export:web": "npx expo export --platform web",
    "export:android": "npx expo export --platform android",
    "production:build": "node scripts/build-production.cjs",
    "production:check": "node scripts/production-preflight.cjs",
    "production:preview": "node scripts/serve-demo.cjs dist-production",
    "test:production": "node tests/productionPayments.cjs",
    "test:final-hardening": "tsx tests/finalBlockerClosure.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "babel-preset-expo": "~57.0.12",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.10",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3"
  },
  "private": true
}