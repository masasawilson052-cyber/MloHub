# ==============================================================================
# MLOHUB ENVIRONMENT CONFIGURATION & SECRETS
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholder credentials.
# Note: Variables prefixed with EXPO_PUBLIC_ are accessible inside client code.
# Backend secrets (Service Role, Webhook Secrets) must stay on secure servers.

# App Environment (sandbox, development, production)
EXPO_PUBLIC_APP_ENV=sandbox
EXPO_PUBLIC_API_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Public credentials (used by mobile client & web)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Backend Secret (Server-side / Edge Functions only - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 2. TANZANIAN SMS GATEWAY (OTP & INVITATIONS)
# ------------------------------------------------------------------------------
# SMS Provider Options: sandbox, nextsms, beem, twilio
SMS_PROVIDER=sandbox

# NextSMS Tanzania Credentials
NEXTSMS_USERNAME=your-nextsms-username
NEXTSMS_PASSWORD=your-nextsms-password
NEXTSMS_SENDER_ID=MLOHUB

# Beem Africa Tanzania Credentials
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key
BEEM_SENDER_NAME=MLOHUB

# ------------------------------------------------------------------------------
# 3. TANZANIAN MOBILE MONEY PAYMENT GATEWAY (CLICKPESA / SELCOM / SANDBOX)
# ------------------------------------------------------------------------------
# Payment Provider Options: sandbox, clickpesa, selcom
PAYMENT_PROVIDER=sandbox

# ClickPesa Tanzania Credentials (M-Pesa, Airtel, Mixx by Yas, HaloPesa, Cards)
CLICKPESA_CLIENT_ID=your-clickpesa-client-id
CLICKPESA_API_KEY=your-clickpesa-api-key
CLICKPESA_BASE_URL=https://api.clickpesa.com/v1
CLICKPESA_WEBHOOK_SECRET=your-clickpesa-webhook-hmac-secret

# Platform Commission Rate (e.g., 0.10 for 10% platform fee)
MLOHUB_PLATFORM_COMMISSION_RATE=0.10
